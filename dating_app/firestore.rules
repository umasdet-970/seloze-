rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI + `firebase use <project-id>` first).
//
// Known simplification: matches and mutual-like notifications require one
// user's client to write into another user's subcollection (see the
// `matches` and `likesReceived` rules below) — that's inherent to running
// the match transaction client-side. A production hardening pass would
// move that logic into a Cloud Function (triggered on `likesReceived`
// writes) so clients only ever write their own data, and these rules
// would tighten to strictly per-owner writes. Documented here rather than
// silently shipped as if it were already fully hardened.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Profile fields are readable by any signed-in user (Discover needs
      // to read other users' cards); only the owner can write their own.
      allow read: if signedIn();
      allow write: if isOwner(uid);

      match /private/{docId} {
        // Preferences, settings, and the daily discovery quota are never
        // shown to other users.
        allow read, write: if isOwner(uid);
      }

      match /swipes/{targetId} {
        allow read, write: if isOwner(uid);
      }

      match /likesReceived/{fromId} {
        allow read: if isOwner(uid);
        // The liker (not the subcollection owner) creates this doc when
        // they like someone who hasn't liked back yet.
        allow create: if isOwner(fromId);
        // Deleted by the subcollection owner once they like back and the
        // match transaction fires.
        allow delete: if isOwner(uid);
      }

      match /matches/{otherId} {
        allow read: if isOwner(uid);
        // The like transaction writes a match doc into BOTH
        // participants' subcollections — allow either side to create it.
        allow create: if isOwner(uid) || isOwner(otherId);
        allow delete: if isOwner(uid); // unmatch/block removes your own copy
      }

      match /blocked/{targetId} {
        allow read, write: if isOwner(uid);
      }

      match /reported/{targetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        // Immutable once filed — no update/delete, prevents tampering
        // with your own report history.
      }

      match /notifications/{id} {
        allow read, update: if isOwner(uid);
        // Notifications about you (new like, match, etc.) are created by
        // whichever signed-in user's action triggered them, not
        // necessarily uid themselves.
        allow create: if signedIn();
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      function isParticipantOnCreate() {
        return signedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read, update: if isParticipant();
      allow create: if isParticipantOnCreate();

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn(); // markRead flips `read` on the other participant's messages
      }
    }

    match /reports/{id} {
      // Top-level collection for the admin dashboard — write-only from
      // clients (filing a report), never readable by clients. Admin
      // tooling reads this via the Admin SDK / a service account, which
      // bypasses these rules entirely.
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
