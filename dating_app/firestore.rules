rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI + `firebase use <project-id>` first).
//
// Known simplification: matches and mutual-like notifications require one
// user's client to write into another user's subcollection (see the
// `matches` and `likesReceived` rules below) — that's inherent to running
// the match transaction client-side. A production hardening pass would
// move that logic into a Cloud Function (triggered on `likesReceived`
// writes) so clients only ever write their own data, and these rules
// would tighten to strictly per-owner writes. Documented here rather than
// silently shipped as if it were already fully hardened.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin dashboard access, gated by an `admin` custom claim on the
    // signed-in Firebase Auth token. Rules can only CHECK a claim, not
    // grant one — see admin_dashboard/FIREBASE_SETUP.md for the one-time
    // Admin SDK script that sets it on a specific admin's account.
    //
    // Known simplification: `isAdmin()` grants that account broad write
    // access to any `users/{uid}` doc (needed for moderation actions like
    // setUserStatus/setVerified), not just the accountStatus/isVerified
    // fields it's actually meant to touch. A production hardening pass
    // would use `request.resource.data.diff(resource.data).affectedKeys()`
    // to restrict admin writes to exactly those fields. Documented here
    // rather than silently shipped as if it were already fully scoped —
    // same spirit as the matches/likesReceived simplification below.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      // Profile fields are readable by any signed-in user (Discover needs
      // to read other users' cards); only the owner (or an admin, for
      // moderation actions) can write.
      allow read: if signedIn();
      allow write: if isOwner(uid) || isAdmin();

      match /private/{docId} {
        // Preferences, settings, and the daily discovery quota are never
        // shown to other users. `account` holds personal data — email, phone,
        // date of birth, push tokens — which must NOT sit on the profile doc
        // above (any signed-in member can read that). Only the owner reads it,
        // plus admins, for support and moderation.
        allow read: if isOwner(uid) || (isAdmin() && docId == 'account');
        // `rewards` (invite-a-friend referralCount) is written ONLY by the
        // creditReferralOnProfileComplete Cloud Function via the Admin SDK,
        // which bypasses rules. If clients could write it, anyone could
        // grant themselves the maximum discovery bonus.
        allow write: if isOwner(uid) && docId != 'rewards';
      }

      match /swipes/{targetId} {
        allow read, write: if isOwner(uid);
      }

      match /likesReceived/{fromId} {
        allow read: if isOwner(uid);
        // The liker (not the subcollection owner) creates this doc when
        // they like someone who hasn't liked back yet.
        allow create: if isOwner(fromId);
        // Deleted by the subcollection owner once they like back and the
        // match transaction fires.
        allow delete: if isOwner(uid);
      }

      match /matches/{otherId} {
        allow read: if isOwner(uid);
        // The like transaction writes a match doc into BOTH
        // participants' subcollections — allow either side to create it.
        allow create: if isOwner(uid) || isOwner(otherId);
        allow delete: if isOwner(uid); // unmatch/block removes your own copy
      }

      match /blocked/{targetId} {
        allow read, write: if isOwner(uid);
      }

      match /reported/{targetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        // Immutable once filed — no update/delete, prevents tampering
        // with your own report history.
      }

      match /notifications/{id} {
        allow read, update: if isOwner(uid);
        // Notifications about you (new like, match, etc.) are created by
        // whichever signed-in user's action triggered them, not
        // necessarily uid themselves.
        allow create: if signedIn();
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      function isParticipantOnCreate() {
        return signedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read, update: if isParticipant();
      allow create: if isParticipantOnCreate();

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn(); // markRead flips `read` on the other participant's messages
      }
    }

    match /reports/{id} {
      // Top-level collection for the admin dashboard. Clients can only
      // file a report (create); reading/resolving the queue needs the
      // `admin` custom claim. Never deletable — resolved reports stay as
      // a moderation audit trail.
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /reengagement/{uid} {
      // Bookkeeping for the daily re-engagement push (who was pushed or held
      // out, and whether they came back) — written only by the
      // sendReengagementPush Cloud Function. Admin-readable for analysis.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reengagementSummary/{docId} {
      // Pushed-vs-held-out comparison, refreshed by the same function.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /referrals/{inviteeId} {
      // One doc per invited friend (id = the friend's uid), written only by
      // the creditReferralOnProfileComplete Cloud Function. Doubles as the
      // "already credited" marker and as data for the admin dashboard.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analyticsFunnel/{uid} {
      // Per-user funnel milestones (spec section 17) — written by the
      // owner as they hit each stage, read by admin for funnel counts.
      allow write: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
    }

    match /auditLogs/{id} {
      // Written automatically by AdminRepository on every moderation
      // action (spec section 20) — create-only, never editable/deletable,
      // including by another admin, so it stays a trustworthy record.
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /revenueCatEvents/{id} {
      // LTV data plumbing (spec section 17) — written exclusively by the
      // revenueCatWebhook Cloud Function via the Admin SDK, which
      // bypasses these rules entirely, so there's no `create` case for
      // any client here (not even admin) to match — a client writing
      // directly would let anyone report fake revenue for themselves.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adSpend/{id} {
      // CAC data plumbing (spec section 17). No automated writer exists
      // yet (would need a Meta/Google Ads API integration) — admins can
      // enter spend manually (Firestore console, or a future admin
      // dashboard form) until then, which is why this allows admin
      // writes, unlike revenueCatEvents above.
      allow read, write: if isAdmin();
    }

    // Collection-group rules for the admin dashboard's aggregate stats
    // (total matches, total messages). A `count()` query needs the
    // matching collection-group rule below in addition to (not instead
    // of) the path-specific rules above — Firestore ORs across every
    // rule block that matches, so this doesn't loosen non-admin access.
    match /{path=**}/matches/{matchId} {
      allow read: if isAdmin();
    }
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }

    // "Who has blocked me" — FirestoreSocialRepository runs
    //   collectionGroup('blocked').where('targetId', isEqualTo: myUid)
    // so a blocked user's Discover/matches can hide whoever blocked them.
    // Without this rule the query was denied on every login and blocking
    // only worked in one direction. Scoped so a signed-in user can only
    // ever match `blocked` docs that name THEM as the target (Firestore
    // rejects the query unless it carries that same filter).
    //
    // Known trade-off, documented rather than hidden: this lets a blocked
    // user's client learn which uids blocked them. The app never displays
    // that, but a modified client could. Closing it fully would mean
    // moving the "hide blockers" filtering into a Cloud Function so
    // clients never read these docs at all.
    match /{path=**}/blocked/{targetId} {
      allow read: if signedIn() && resource.data.targetId == request.auth.uid;
    }
  }
}
